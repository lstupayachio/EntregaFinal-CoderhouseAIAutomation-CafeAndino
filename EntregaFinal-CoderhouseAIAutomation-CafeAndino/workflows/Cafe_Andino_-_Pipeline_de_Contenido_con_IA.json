    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst blocks = [];\nlet total = 0;\nfor (const item of items) {\n  const f = item.json.fields;\n  if (!f) continue;\n  total++;\n  const block = \"Tema: \" + (f[\"Tema\"] || \"\") + \"\\n\" +\n    \"Categoría: \" + (f[\"Categoría\"] || \"\") + \"\\n\" +\n    \"Palabras clave: \" + (f[\"Palabras clave\"] || \"\") + \"\\n\" +\n    \"Información: \" + (f[\"Información\"] || \"\");\n  blocks.push(block);\n}\nreturn [{ json: { context: blocks.join(\"\\n---\\n\"), total_fuentes: total } }];"
      },
